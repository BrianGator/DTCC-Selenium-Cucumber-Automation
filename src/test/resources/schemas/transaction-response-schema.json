{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["orderId", "transactionRef", "status", "processedTimestamp"],
  "properties": {
    "orderId": { "type": "string" },
    "transactionRef": { "type": "string" },
    "status": { "type": "string", "enum": ["PROCESSED", "PENDING_HIGH_VALUE", "REJECTED"] },
    "processedTimestamp": { "type": "string" }
  }
}
