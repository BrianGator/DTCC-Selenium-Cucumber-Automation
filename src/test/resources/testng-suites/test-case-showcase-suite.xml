<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DTCC Test Case Showcase Suite" verbose="1" parallel="false">
    <listeners>
        <listener class-name="com.dtcc.automation.utils.TestExecutionListener"/>
    </listeners>
    <test name="API Tests">
        <classes>
            <class name="com.dtcc.automation.api.BackendTransactionTest"/>
            <class name="com.dtcc.automation.api.DataDrivenTransactionTest"/>
        </classes>
    </test>
    <test name="Login Tests">
        <classes>
            <class name="com.dtcc.automation.ui.LoginValidationTest"/>
        </classes>
    </test>
    <test name="Selenium Tests">
        <classes>
            <class name="com.dtcc.automation.ui.SeleniumOrderLifecycleTest"/>
        </classes>
    </test>
    <test name="Cucumber Tests">
        <classes>
            <class name="com.dtcc.automation.runners.CucumberTestRunner"/>
        </classes>
    </test>
    <test name="CI-CD Tests">
        <classes>
            <class name="com.dtcc.automation.cicd.CiCdConfigurationTest"/>
        </classes>
    </test>
    <test name="Regression Tests">
        <classes>
            <class name="com.dtcc.automation.regression.RegressionSmokeTest"/>
        </classes>
    </test>
    <test name="SQL Database Tests">
        <classes>
            <class name="com.dtcc.automation.database.SqlDatabaseValidationTest"/>
        </classes>
    </test>
    <test name="Unit Tests">
        <classes>
            <class name="com.dtcc.automation.unit.OrderCalculatorTestNgTest"/>
        </classes>
    </test>
</suite>
