<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DTCC Public Website Automation Suite" parallel="false">
    <listeners>
        <listener class-name="com.dtcc.automation.utils.TestExecutionListener"/>
    </listeners>
    <test name="DTCC Public Website Selenium and Sitemap Tests">
