<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DTCC Allure UI Report Suite" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.dtcc.automation.utils.TestExecutionListener"/>
    </listeners>
    <test name="Allure Annotated UI API Database Tests">
        <classes>
            <class name="com.dtcc.automation.reports.AllureEnabledUiReportTest"/>
            <class name="com.dtcc.automation.reports.DtccPublicAllureShowcaseTest"/>
            <class name="com.dtcc.automation.reports.DtccExtendedAllureCoverageTest"/>
            <class name="com.dtcc.automation.reports.DtccAdditionalAllureCoverageTest"/>
            <class name="com.dtcc.automation.reports.DtccMoreAllureCoverageTest"/>
            <class name="com.dtcc.automation.coverage.ui.DtccAllureUiSuitesTest"/>
            <class name="com.dtcc.automation.coverage.api.DtccAllureApiSuitesTest"/>
            <class name="com.dtcc.automation.coverage.db.DtccAllureDbSuitesTest"/>
            <class name="com.dtcc.automation.coverage.reportui.DtccAllureReportUiSuitesTest"/>
            <class name="com.dtcc.automation.ui.LoginValidationTest"/>
            <class name="com.dtcc.automation.ui.SeleniumOrderLifecycleTest"/>
            <class name="com.dtcc.automation.api.BackendTransactionTest"/>
            <class name="com.dtcc.automation.database.SqlDatabaseValidationTest"/>
        </classes>
    </test>
</suite>
