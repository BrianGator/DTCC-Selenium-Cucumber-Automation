<!-- Add this dependency to a standalone Maven Selenium framework when adding Selenide. -->
<dependency>
    <groupId>com.codeborne</groupId>
    <artifactId>selenide</artifactId>
    <version>7.3.0</version>
    <scope>test</scope>
</dependency>

<!-- Optional: Allure reporting works well with Selenide + TestNG. -->
<dependency>
    <groupId>io.qameta.allure</groupId>
    <artifactId>allure-testng</artifactId>
    <version>2.13.9</version>
    <scope>test</scope>
</dependency>
